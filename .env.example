# Šablóna. Skutočný .env vytvorí setup.sh s náhodnými heslami, práva 600.
# .env nikdy nepatrí do Gitu ani do chatu.

# DNS meno servera dohodnuté s IT, bez https:// a bez portu.
GITEA_DOMAIN=gitea.example.internal

POSTGRES_PASSWORD=
GITEA_SECRET_KEY=
GITEA_INTERNAL_TOKEN=

# true: web aj repozitáre vidia iba prihlásení. Rozhodnutie je otvorené, pozri docs/04-produkcia.md.
REQUIRE_SIGNIN_VIEW=true
